(function(w) {
  // 防抖
  function debounce(fn, wait) {
    let timeout = null
    return function() {
      if (timeout !== null) {
        clearTimeout(timeout)
      }
      timeout = setTimeout(fn, wait)
    }
  }
  function isObject({ params, msg }) {
    if (params && Object.prototype.toString.call(params) !== '[object Object]') {
      throw Error(msg || '参数格式必须为一个对象')
    }
  }
  const brandColor = ['#00A743']
  const baseColor = ['#ffffff', '#333333', '#555555', '#999999', '#D8D8D8', '#ECEDEE']
  const seriesColor = ['#50C1FF', '#12D9B4', '#FFA057', '#5D89FF', '#D167F1', '#F16B71', '#689CD1', '#FFD256', '#26BBAA', '#9BAABA', 'RGBA(111, 146, 0, 0.48)', '#00A743']
  const labelColor = ['#28374F']

  const labelRotate = 30

  const grid = {
    left: '20',
    right: '20',
    bottom: '32',
    top: '60',
    containLabel: true
  }

  const legend = {
    type: 'scroll',
    width: '100%',
    left: 'center',
    top: 5
  }

  /* 当有图表有标题存在时的配置 */
  const gridWidthTitle = {
    left: '20',
    right: '20',
    bottom: '32',
    top: '80',
    containLabel: true
  }

  const legendWidthTitle = {
    type: 'scroll',
    width: '100%',
    left: 'center',
    top: 30
  }

  const colorFontSize = {
    color: baseColor[1],
    fontSize: 12,
    lineHeight: 16
  }

  /* 轴线 */
  const axisLineColor = {
    color: baseColor[4]
  }
  /* 分割线 */
  const splitLineStyle = {
    color: [baseColor[5]],
    // color: .ECEDEE,
    width: 1,
    type: 'dashed'
  }
  /* x、y轴 label样式 */
  const axisLabelStyle = {
    color: labelColor[0],
    fontSize: 14 ,
  }
  /* series label样式 */
  const seriesLabelStyle = {
    show: true,
    position: 'top',
    rotate: 45,
    color: labelColor[0],
    fontSize: 14,
  }

  /* 图表标题配置 */
  const titleFn = (textStyle = {}) => {
    isObject({ params: textStyle })
    return {
      top: 0,
      x: 'center',
      show: true,
      textStyle: {
        color: baseColor[1],
        fontSize: 18,
        fontWeight: 'bold',
        ...textStyle
      }
    }
  }

  /* dataZoom */
  const dataZoom = {
    type: 'slider',
    bottom: 10,
    start: 0,
    end: 100,
    height: 4,
    backgroundColor: baseColor[5],
    fillerColor: 'rgba(192, 198, 204, 0.42)',
    borderColor: 'transparent',
    handleIcon: 'image://data:image/png;base64,',
    handleSize: 32,
    textStyle: {
      fontSize: '12px',
      color: baseColor[1],
      lineHeight: '17px'
    },
    handleStyle: {
      borderColor: '#B7B7B7'
    },
    brushSelect: false,
    selectedDataBackground: {
      lineStyle: {
        color: '#fff',
        opacity: 'transparent'
      }
    },
    dataBackground: {
      areaStyle: {
        color: 'transparent',
        opacity: 0,
        shadowColor: 'transparent'
      },
      lineStyle: {
        color: 'transparent'
      }
    }
  }

  /* toolbox */
  const toolBoxFn = (params = {}) => {
    isObject({ params })
    const { mySaveAsImage, optionToContent, contentToOption } = params
    const obj = {
      show: true,
      top: legend.top, // 和 legend 的 top 保持一致
      itemSize: 18,
      iconStyle: {
        borderColor: baseColor[2],
        emphasis: {
          borderColor: brandColor[0]
        }
      },
      feature: {
        dataView: {
          show: true,
          readOnly: false,
          icon: 'image://data:image/png;base64,'
        },
        // saveAsImage: {
        //   show: true,
        //   backgroundColor: baseColor[0],
        //   type: 'png',
        //   name: saveAsImageName,
        //   icon: 'image://data:image/png;base64,'
        // },
        myTool1: {
          show: true,
          title: '保存为图片',
          icon: 'image://data:image/png;base64,',
          onclick: function() {
            mySaveAsImage()
          }
        },
        restore: {
          show: true,
          icon: 'image://data:image/png;base64,'
        },
        magicType: {
          show: true,
          type: ['line', 'bar'],
          icon: {
            line: 'image://data:image/png;base64,',
            bar: 'image://data:image/png;base64,'
          }
        }
      }
    }
    if (optionToContent) {
      obj.feature.dataView.optionToContent = optionToContent
    }
    if (contentToOption) {
      obj.feature.dataView.contentToOption = contentToOption
    }
    return obj
  }
  /* xAxisLabelFormatterFn：格式x轴label
  参数说明：
    label---必传,展示文字;
    isWrap--非必传,文字是否需要换行,默认值false不换行;
    row-----非必传,文字最多展示行数,默认值2，isWrap为ture时生效;
    col-----非必传,每行文字最大长度,超出显示省略号,默认值6,isWrap为ture时生效。
  使用：xxx.xAxisLabelFormatterFn({ label,isWrap,row,col })
  */
  const xAxisLabelFormatterFn = ({ label, isWrap = false, row = 2, col = 6 } = {})=>{
    if (isWrap) {
      const arr = []
        for (let i = 1; i <= row; i++) {
          if (i === row) {
              let a = label.slice(col * (i - 1))
              if (a.length > col) {
                  a = a.slice(0, col - 1) + '…'
              }
              if (a) {
                  arr.push(a)
              }
          } else {
              const a = label.slice(col * (i - 1), col * i)
              if (a) {
                  arr.push(a)
              }
          }
        }
      label = arr.join('\n')
    }
    return label
  }
  const echartsMixin = {
    data() {
      return {
        chartDOMArr: [],
        chartResizeNew: function() {}
      }
    },
    mounted() {
      this.chartResizeNew = debounce(this.chartResize, 500)
      this.echartsAfter()
    },
    beforeDestroy() {
      this.destroyEchart()
      this.removeListener()
      this.chartDOMArr = []
    },
    methods: {
      chartResize() {
        if (!this.chartsRefsName || (typeof this.chartsRefsName !== 'string' && Object.prototype.toString.call(this.chartsRefsName) !== '[object Array]')) {
          throw Error('初始化数据 this.chartsRefsName [string|Array] 缺少或类型错误；（this.chartsRefsName 为 chart $refs 定义的名称；）')
        }
        // 批量绑定 resize
        let refsArr = []
        if (typeof this.chartsRefsName === 'string') {
          refsArr.push(this.chartsRefsName)
        } else if (Array.isArray(this.chartsRefsName)) {
          refsArr = [...this.chartsRefsName]
        }
        refsArr.forEach(refName => {
          const chartDOM = this.$refs[refName]
          if (chartDOM) {
            const chart = this.$echarts.getInstanceByDom(chartDOM)
            if (chart) {
              this.chartDOMArr.push(chart)
              chart.resize()
            }
          }
        })
      },
      destroyEchart() {
        this.chartDOMArr.forEach(dom => {
          this.$echarts.dispose(dom)
        })
      },
      echartsAfter() {
        window.addEventListener('resize', this.chartResizeNew)
        // @TODO 左边sidebarMenu class = sidebar-container 名可能不存在
        const sidebarElm = document.getElementsByClassName('sideBar-menus')[0]
        sidebarElm && sidebarElm.addEventListener('transitionend', this.chartResizeNew)
      },
      removeListener() {
        window.removeEventListener('resize', this.chartResizeNew)
        const sidebarElm = document.getElementsByClassName('sideBar-menus')[0]
        sidebarElm && sidebarElm.removeEventListener('transitionend', this.chartResizeNew)
      }
    }
  }

  w.echartsConfig = {
    brandColor,
    baseColor,
    seriesColor,
    labelColor,

    labelRotate,
    grid,
    legend,
    gridWidthTitle,
    legendWidthTitle,
    colorFontSize,
    axisLineColor,
    splitLineStyle,
    titleFn,
    dataZoom,
    toolBoxFn,
    xAxisLabelFormatterFn,

    axisLabelStyle,
    seriesLabelStyle,

    echartsMixin
  }
})(window);